#!/usr/bin/env python3
"""Compile the checked-in catalogs. Run from any directory; no downloads.

translations/<code>.json was copied read-only from Omarchy Theme Manager's
STRINGS in i18n.py (including extra_i18n.py), plus workspace_i18n.py.
Port additions belong in translations/extra/<code>.json. Do not modify the
upstream checkout. Plural tables are preserved in JSON but only string
entries are compiled: callers use literal English tr/trf keys.
"""
import json
from pathlib import Path
root = Path(__file__).resolve().parent.parent
catalogs = {}
for code in ('en', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl'):
    merged = {}
    for folder in ('translations', 'translations/extra'):
        file = root / folder / f'{code}.json'
        if file.exists():
            merged.update(json.loads(file.read_text()))
    catalogs[code] = {key: value for key, value in merged.items() if isinstance(value, str)}
output = '// Generated by tools/gen-translations. Do not edit.\nconst translationCatalogs = <String, Map<String, String>>' + json.dumps(catalogs, ensure_ascii=False, indent=2).replace('$', r'\$') + ';\n'
(root / 'packages/maprisma_theme_core/lib/src/translations.g.dart').write_text(output)
