#!/usr/bin/env python3
"""One-time copy of the Omarchy Theme Manager data into Maprisma Theme.

    tools/import-omarchy [SOURCE]   (default /mnt/Data/cosmic-migration/omarchy-theme-data)

SOURCE holds Omarchy's themes/, backgrounds/ and theme-manager/ (copied off the Omarchy
disk). Themes and wallpapers are copied only where Maprisma Theme has none of that name;
the state files (hidden, favorites, recent, …) only when Maprisma Theme has none yet.
Settings: the keys that mean the same on COSMIC are taken over. Nothing in SOURCE changes.
"""
import json
import os
import shutil
import sys
from pathlib import Path

source = Path(sys.argv[1] if len(sys.argv) > 1 else "/mnt/Data/cosmic-migration/omarchy-theme-data")
config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "maprisma-theme"
STATE = ["hidden.json", "hidden-wallpapers.json", "recent.json", "favorites.json",
         "workspace-wallpapers.json", "workspace-themes.json", "shortcuts.json"]
SETTINGS = ["workspace_wallpapers", "workspace_themes", "corners", "sort", "slideshow_minutes",
            "schedule", "screenshot_key", "ask_ai", "ask_ai_helper", "ask_prompts", "maprisma_hints",
            "header_order"]


def copy_tree(src: Path, dst: Path, what: str) -> None:
    if not src.is_dir():
        return
    dst.mkdir(parents=True, exist_ok=True)
    for entry in sorted(src.iterdir()):
        target = dst / entry.name
        if target.exists() or entry.is_symlink():
            print(f"  {what} {entry.name}: kept the existing one")
            continue
        shutil.copytree(entry, target, symlinks=True) if entry.is_dir() else shutil.copy2(entry, target)
        print(f"  {what} {entry.name}")


def main() -> int:
    if not (source / "theme-manager").is_dir():
        print(f"{source} has no theme-manager/ folder", file=sys.stderr)
        return 1
    config.mkdir(parents=True, exist_ok=True)
    os.chmod(config, 0o700)
    copy_tree(source / "themes", config / "themes", "theme")
    copy_tree(source / "backgrounds", config / "backgrounds", "wallpapers of")
    for name in STATE:
        src, dst = source / "theme-manager" / name, config / name
        if src.is_file() and not dst.exists():
            shutil.copy2(src, dst)
            os.chmod(dst, 0o600)
            print(f"  {name}")
    old = source / "theme-manager" / "settings.json"
    new = config / "settings.json"
    if old.is_file():
        current = json.loads(new.read_text()) if new.is_file() else {}
        taken = json.loads(old.read_text())
        for key in SETTINGS:
            if key in taken and key not in current:
                current[key] = taken[key]
        new.write_text(json.dumps(current, indent=2) + "\n")
        os.chmod(new, 0o600)
        print("  settings")
    print(f"Imported into {config}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
