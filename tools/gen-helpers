#!/usr/bin/env python3
"""Build the built-in copy of the AI helpers catalog from data/helpers.json (a copy of Maprisma's
data/helpers.json, made from its agent adapters). Run from any directory after copying a newer
one in; no downloads:

    cp ../maprisma/data/helpers.json packages/maprisma_theme_core/data/helpers.json
    tools/gen-helpers

The core's test checks that the two agree."""
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
core = root / 'packages/maprisma_theme_core'
text = (core / 'data/helpers.json').read_text(encoding='utf-8')
data = json.loads(text)
if not isinstance(data.get('version'), int) or not isinstance(data.get('helpers'), list):
    raise SystemExit('data/helpers.json: not a helpers catalog')
if "'''" in text:
    raise SystemExit("data/helpers.json: contains ''' (not possible in the Dart raw string)")
(core / 'lib/src/helpers_shipped.g.dart').write_text(
    '// Generated by tools/gen-helpers from data/helpers.json. Do not edit.\n'
    "const shippedHelpersJson = r'''" + text + "''';\n", encoding='utf-8')
print(f"helpers.json version {data['version']}: {len(data['helpers'])} helpers")
