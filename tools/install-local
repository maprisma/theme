#!/bin/bash
# Build and install Maprisma Theme for this user (no sudo):
#
#   tools/install-local [--no-build]
#
# ~/.local/lib/maprisma-theme      the Flutter bundle + bin/ (core CLI, helper, applet) + share/ (themes, templates)
# ~/.local/bin/maprisma-theme{,-core,-helper}, maprisma-theme-applet   links
# ~/.local/share/applications      the app's and the applet's desktop entries; icons under hicolor
# ~/.config/autostart              the tray/automation daemon (KDE Plasma only; COSMIC has the applet)
#
# A running Flutter app maps its code from the bundle: never copy over it. The running copies are
# stopped (by their real program path), a fresh folder is swapped in, and the app is not restarted.
# The panel applet is restarted by COSMIC's panel when its binary changed (kill it; the panel respawns it).
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
lib="$HOME/.local/lib/maprisma-theme"
bin="$HOME/.local/bin"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
build=1
[[ ${1:-} == --no-build ]] && build=0
export PATH="${FLUTTER:-/mnt/Data/flutter/bin}:$PATH"
bundle="$root/flutter_app/build/linux/x64/release/bundle"

if (( build )); then
  "$root/tools/gen-translations"
  (cd "$root/flutter_app" && flutter build linux --release --no-tree-shake-icons >/dev/null)
  (cd "$root/cosmic" && cargo build --release -q)   # fetches the crates on a fresh checkout
  mkdir -p "$bundle/bin"
  (cd "$root/packages/maprisma_theme_core" && dart compile exe bin/maprisma_theme_core.dart -o "$bundle/bin/maprisma-theme-core" >/dev/null)
  install -m755 "$root/cosmic/target/release/maprisma-theme-helper" "$root/cosmic/target/release/maprisma-theme-applet" "$bundle/bin/"
  install -m755 "$root/hyprland/maprisma-caelestia-bridge" "$bundle/bin/"   # Hyprland/Caelestia backend
  rm -rf "$bundle/share" && mkdir -p "$bundle/share/maprisma-theme"
  cp -a "$root/themes" "$root/templates" "$bundle/share/maprisma-theme/"
fi
for f in maprisma-theme bin/maprisma-theme-core bin/maprisma-theme-helper bin/maprisma-theme-applet bin/maprisma-caelestia-bridge share/maprisma-theme/themes; do
  [[ -e $bundle/$f ]] || { echo "missing in the build: $f" >&2; exit 1; }
done

running() {
  local p exe
  for p in /proc/[0-9]*; do
    exe=$(readlink "$p/exe" 2>/dev/null) || continue
    exe=${exe% (deleted)}
    [[ $exe == "$lib/"* || $exe == "$lib".*/* ]] && echo "${p#/proc/}"
  done
  return 0
}

mkdir -p "$(dirname "$lib")"
new=$(mktemp -d "$lib.new.XXXXXX")
trap 'rm -rf -- "$new"' EXIT
cp -a "$bundle/." "$new/"
chmod 755 "$new"
pids=$(running)
if [[ -n $pids ]]; then
  echo "Stopping: $(echo $pids)"
  kill -TERM $pids 2>/dev/null || true
  for _ in $(seq 1 50); do [[ -z $(running) ]] && break; sleep 0.1; done
  left=$(running); [[ -n $left ]] && { kill -KILL $left 2>/dev/null || true; sleep 0.3; }
fi
old=""
if [[ -e $lib ]]; then old=$(mktemp -d "$lib.old.XXXXXX"); rmdir "$old"; mv "$lib" "$old"; fi
mv "$new" "$lib"
trap - EXIT
[[ -n $old ]] && rm -rf -- "$old"

mkdir -p "$bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$lib/maprisma-theme" "$bin/maprisma-theme"
for b in maprisma-theme-core maprisma-theme-helper maprisma-theme-applet; do ln -sfn "$lib/bin/$b" "$bin/$b"; done
# Exec with the full path, quoted: Plasma's own PATH has no ~/.local/bin.
gui="$bin/maprisma-theme"
gui=${gui//\\/\\\\}; gui=${gui//\"/\\\"}; gui=${gui//\`/\\\`}; gui=${gui//\$/\\\$}
# …then the desktop file value layer: every backslash doubled again, % as %%.
gui=${gui//\\/\\\\}; gui=${gui//\%/%%}
{ grep -v '^Exec=' "$root/packaging/com.maprisma.Theme.desktop"; printf 'Exec="%s"\n' "$gui"; } > "$data/applications/com.maprisma.Theme.desktop"
# A hidden entry that shows or hides the window (panel icons, launchers).
{ grep -vE '^(Exec|Name|Comment|NoDisplay)=' "$root/packaging/com.maprisma.Theme.desktop"; printf 'Name=Maprisma Theme\nComment=Show or hide Maprisma Theme\nNoDisplay=true\nExec="%s" --toggle\n' "$gui"; } > "$data/applications/com.maprisma.Theme.Toggle.desktop"
install -m644 "$root/packaging/com.maprisma.Theme.svg" "$data/icons/hicolor/scalable/apps/"
id=io.github.ubruckhaus.CosmicMaprismaTheme
applet="$bin/maprisma-theme-applet"   # quoted and escaped like the app's Exec above
applet=${applet//\\/\\\\}; applet=${applet//\"/\\\"}; applet=${applet//\`/\\\`}; applet=${applet//\$/\\\$}
applet=${applet//\\/\\\\}; applet=${applet//\%/%%}
{ grep -v '^Exec=' "$root/cosmic/applet/data/$id.desktop"; printf 'Exec="%s"\n' "$applet"; } > "$data/applications/$id.desktop"
install -m644 "$root/cosmic/applet/data/icons/$id-symbolic.svg" "$data/icons/hicolor/scalable/apps/"
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
autostart="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
mkdir -p "$autostart"
# Exec quoted as the desktop entry spec says (a home folder with spaces or quotes still works).
exe="$bin/maprisma-theme-core"
exe=${exe//\\/\\\\}; exe=${exe//\"/\\\"}; exe=${exe//\`/\\\`}; exe=${exe//\$/\\\$}
# …then the desktop file value layer: every backslash doubled again, % as %%.
exe=${exe//\\/\\\\}; exe=${exe//\%/%%}
{ grep -v '^Exec=' "$root/packaging/com.maprisma.Theme.Daemon.desktop"; printf 'Exec="%s" daemon\n' "$exe"; } > "$autostart/com.maprisma.Theme.Daemon.desktop"
# The daemon was stopped with the other running copies: start it again in a Plasma or Hyprland session.
if [[ ":${XDG_CURRENT_DESKTOP:-}:" == *:KDE:* || ":${XDG_CURRENT_DESKTOP:-}:" == *:Hyprland:* ]]; then
  setsid -f "$bin/maprisma-theme-core" daemon >/dev/null 2>&1 < /dev/null || true
fi
echo "Installed Maprisma Theme into $lib"
