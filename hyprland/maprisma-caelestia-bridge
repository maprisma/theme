#!/usr/bin/env python3
"""Maprisma Theme <-> Caelestia (Hyprland) bridge.

Uses the installed caelestia-cli modules, so the shell, Hyprland borders,
terminals and everything else Caelestia themes follow at once.

  apply <colors.json>   Omarchy-style colors -> Caelestia scheme + apply_colours
  current               Caelestia's scheme as Omarchy-style colors
  wallpaper <path>      set the wallpaper (no recolouring)
  wallpaper-get         the wallpaper path shown now
  wallpaper-clear       remove Caelestia's wallpaper state (no wallpaper of its own)

Every command prints one JSON object; errors are {"error": ..., "message": ...}.

The scheme is saved under Caelestia's name "dynamic": Caelestia only knows
schemes shipped in its package, and with "dynamic" its own wallpaper picker
and mode switch keep working (they then recolour from the wallpaper).
"""

import json
import os
import sys
from pathlib import Path
from types import SimpleNamespace

TERM_KEYS = [
    "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
    "bright_black", "bright_red", "bright_green", "bright_yellow",
    "bright_blue", "bright_magenta", "bright_cyan", "bright_white",
]


# The answer goes to a private copy of stdout; fd 1 itself points at stderr, so
# whatever caelestia-cli or the programs it starts print cannot break the JSON.
_answer = None


def out(value):
    data = (json.dumps(value) + "\n").encode()
    if _answer is None:
        sys.stdout.write(data.decode())
        sys.stdout.flush()
    else:
        os.write(_answer, data)


def fail(code, message):
    out({"error": code, "message": message})
    sys.exit(0)


def hexval(value):
    """'#rrggbb' -> 'rrggbb' (lower case), or None."""
    if not isinstance(value, str):
        return None
    v = value.strip().lstrip("#").lower()
    if len(v) == 3:
        v = "".join(c * 2 for c in v)
    if len(v) != 6 or any(c not in "0123456789abcdef" for c in v):
        return None
    return v


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, w):
    """a mixed toward b by w (0..1)."""
    ra, rb = rgb(a), rgb(b)
    return "".join(f"{round(x + (y - x) * w):02x}" for x, y in zip(ra, rb))


def luminance(h):
    r, g, b = (c / 255 for c in rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def load_caelestia():
    try:
        from caelestia.utils import paths, theme  # noqa: F401
        from caelestia.utils.material import generator
    except ImportError as e:
        fail("no_caelestia", f"caelestia-cli is not installed: {e}")
    return paths, theme, generator


def build_colours(colors, generator):
    accent = hexval(colors.get("accent")) or hexval(colors.get("blue"))
    bg = hexval(colors.get("background"))
    fg = hexval(colors.get("foreground"))
    if not (accent and bg and fg):
        fail("bad_colors", "background, foreground and accent are required")
    mode = colors.get("mode")
    if mode not in ("dark", "light"):
        mode = "dark" if luminance(bg) < 0.5 else "light"
    light = mode == "light"

    scheme = SimpleNamespace(mode=mode, variant="tonalspot", flavour="default")
    c = generator.gen_scheme(scheme, generator.hex_to_hct(accent))
    c = {k: v.lower() for k, v in c.items()}

    # The theme's own surfaces and text instead of Material's tinted ones.
    c["primary"] = accent
    c["surfaceTint"] = accent
    for key in ("background", "surface", "base", "surfaceDim"):
        c[key] = bg
    steps = {
        "surfaceContainerLowest": -0.03, "mantle": -0.03, "crust": -0.05,
        "surfaceContainerLow": 0.03, "surfaceContainer": 0.06,
        "surfaceContainerHigh": 0.09, "surfaceContainerHighest": 0.12,
        "surfaceBright": 0.16, "surfaceVariant": 0.12,
        "surface0": 0.14, "surface1": 0.29, "surface2": 0.43,
        "overlay0": 0.57, "overlay1": 0.71, "overlay2": 0.86,
    }
    edge = "000000" if not light else "ffffff"
    for key, w in steps.items():
        c[key] = mix(bg, edge, -w) if w < 0 else mix(bg, fg, w)
    for key in ("onBackground", "onSurface", "text"):
        c[key] = fg
    muted = hexval(colors.get("muted"))
    if muted:
        c["outline"] = muted
        c["subtext0"] = muted
    c["onSurfaceVariant"] = c["subtext1"] = mix(fg, bg, 0.25)
    sel = hexval(colors.get("selection"))
    if sel:
        c["secondaryContainer"] = sel

    # Terminal colours exactly as the theme has them.
    for i, key in enumerate(TERM_KEYS):
        v = hexval(colors.get(key))
        if v is None and key.startswith("bright_"):
            v = hexval(colors.get(key[len("bright_"):]))
        if v is not None:
            c[f"term{i}"] = v
    named = {
        "red": "red", "green": "green", "yellow": "yellow", "blue": "blue",
        "mauve": "magenta", "pink": "magenta", "teal": "cyan", "sky": "cyan",
        "sapphire": "blue", "peach": "orange", "maroon": "red",
    }
    for ckey, okey in named.items():
        v = hexval(colors.get(okey))
        if v is not None:
            c[ckey] = v
    red = hexval(colors.get("red"))
    if red:
        c["error"] = red
    return c, mode


def cmd_apply(path):
    paths, theme, generator = load_caelestia()
    try:
        colors = json.loads(Path(path).read_text())
    except (OSError, ValueError) as e:
        fail("bad_colors", str(e))
    if not isinstance(colors, dict):
        fail("bad_colors", "expected a JSON object")
    colours, mode = build_colours(colors, generator)
    # apply_colours silently does nothing while another theme change holds
    # Caelestia's lock: wait (up to 10 s) until it is free, so the saved
    # scheme and what is applied belong together.
    if not wait_for_theme_lock(paths):
        fail("busy", "another Caelestia theme change is running")
    paths.atomic_dump(paths.scheme_path, {
        "name": "dynamic", "flavour": "default", "mode": mode,
        "variant": "tonalspot", "colours": colours,
    })
    theme.apply_colours(colours, mode)
    out({"applied": True, "mode": mode})


def wait_for_theme_lock(paths, seconds=10.0):
    import fcntl
    import time
    lock = paths.c_state_dir / "theme.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    end = time.monotonic() + seconds
    while True:
        with open(lock, "w") as fd:
            try:
                fcntl.flock(fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True  # free (released again when the file closes)
            except BlockingIOError:
                pass
        if time.monotonic() >= end:
            return False
        time.sleep(0.2)


def cmd_current():
    paths, _, _ = load_caelestia()
    try:
        data = json.loads(paths.scheme_path.read_text())
        c = data["colours"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        fail("no_scheme", str(e))

    def g(key):
        v = hexval(c.get(key))
        return f"#{v}" if v else None

    colors = {
        "mode": data.get("mode", "dark"),
        "background": g("background"), "foreground": g("onSurface"),
        # Caelestia's terminals use "secondary" for the cursor and the selection.
        "accent": g("primary"), "selection": g("secondary"),
        "muted": g("outline"), "cursor": g("secondary"),
    }
    for i, key in enumerate(TERM_KEYS):
        colors[key] = g(f"term{i}")
    colors["orange"] = g("peach")
    out({
        "colors": {k: v for k, v in colors.items() if v},
        "is_dark": data.get("mode", "dark") == "dark",
        "corner_radius": None,
    })


def cmd_wallpaper(path):
    paths, _, _ = load_caelestia()
    from caelestia.utils import wallpaper as w
    wall = Path(path).resolve()
    if not wall.is_file() or not w.is_valid_image(wall):
        fail("bad_image", f"{wall} is not an image")
    # The thumbnail first: a picture that cannot be read changes nothing.
    try:
        wall_cache = w.convert_gif(wall) if wall.suffix.lower() == ".gif" else wall
        thumb = w.get_thumb(wall_cache, paths.wallpapers_cache_dir / paths.compute_hash(wall_cache))
    except Exception as e:  # PIL raises many kinds
        fail("bad_image", f"{wall}: {e}")
    paths.wallpaper_path_path.parent.mkdir(parents=True, exist_ok=True)
    paths.wallpaper_path_path.write_text(str(wall))
    paths.wallpaper_link_path.unlink(missing_ok=True)
    paths.wallpaper_link_path.symlink_to(wall)
    paths.wallpaper_thumbnail_path.unlink(missing_ok=True)
    paths.wallpaper_thumbnail_path.symlink_to(thumb)
    out({"set": True, "path": str(wall)})


def cmd_wallpaper_clear():
    """Back to no wallpaper of its own (undoing a preview from that state)."""
    paths, _, _ = load_caelestia()
    for f in (paths.wallpaper_path_path, paths.wallpaper_link_path, paths.wallpaper_thumbnail_path):
        f.unlink(missing_ok=True)
    out({"cleared": True})


def cmd_wallpaper_get():
    paths, _, _ = load_caelestia()
    try:
        text = paths.wallpaper_path_path.read_text().strip()
    except OSError:
        text = ""
    out({"path": text or None})


def main(argv):
    if len(argv) >= 2 and argv[0] == "apply":
        return cmd_apply(argv[1])
    if argv == ["current"]:
        return cmd_current()
    if len(argv) >= 2 and argv[0] == "wallpaper":
        return cmd_wallpaper(argv[1])
    if argv == ["wallpaper-get"]:
        return cmd_wallpaper_get()
    if argv == ["wallpaper-clear"]:
        return cmd_wallpaper_clear()
    fail("usage", "apply <colors.json> | current | wallpaper <path> | wallpaper-get | wallpaper-clear")


if __name__ == "__main__":
    os.umask(0o022)
    sys.stdout.flush()
    _answer = os.dup(1)
    os.dup2(2, 1)
    main(sys.argv[1:])
