# fuzzel colours from Maprisma Theme ({{ theme_type }} theme). fuzzel.ini includes this file
# last (a marked [main] include at its end), so these win over its own [colors].
[colors]
background={{ background_strip }}f0
text={{ foreground_strip }}ff
prompt={{ accent_strip }}ff
placeholder={{ muted_strip }}ff
input={{ foreground_strip }}ff
match={{ accent_strip }}ff
selection={{ selection_background_strip }}ff
selection-text={{ selection_foreground_strip }}ff
selection-match={{ accent_strip }}ff
counter={{ muted_strip }}ff
border={{ accent_strip }}aa
